{
  "name": "jcreatepp",
  "version": "1.0.0",
  "description": "Blockly-based visual editor for generating Cluster Script compatible JavaScript",
  "main": "index.js",
  "private": true,
  "scripts": {
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/blocks.test.js .test-build/test/snapshot.test.js .test-build/test/sim.test.js .test-build/test/blockEdit.test.js .test-build/test/placement.test.js .test-build/test/variables.test.js .test-build/test/steerInput.test.js .test-build/test/realdevice.test.js .test-build/test/behavior.test.js .test-build/test/format.test.js .test-build/test/unitySetup.test.js .test-build/test/demos.test.js .test-build/test/parts.test.js .test-build/test/previewInfo.test.js",
    "realdevice:export": "tsc -p tsconfig.test.json && node .test-build/test/realdevice/export.js",
    "test:update": "tsc -p tsconfig.test.json && node .test-build/test/snapshot.test.js --update-snapshots && node .test-build/test/behavior.test.js --update-snapshots",
    "build": "webpack --mode production",
    "start": "webpack serve --open --mode development",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "blockly"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/three": "0.186.0",
    "css-loader": "^6.7.1",
    "html-webpack-plugin": "^5.5.0",
    "source-map-loader": "^4.0.1",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.4.2",
    "typescript": "^5.0.2",
    "vitepress": "^1.6.4",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "dependencies": {
    "blockly": "^12.0.0",
    "three": "0.186.1"
  }
}
